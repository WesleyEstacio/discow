SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Neon Postgres connection string (from console.neon.tech > your project > Connection Details).
# Use the "pooled connection" string so it works well from serverless functions.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Random secret used by Auth.js to sign/encrypt cookies and tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=your_auth_secret

# Google OAuth credentials (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Production URL, used for metadata (canonical links, Open Graph images,
# sitemap.xml, robots.txt). Falls back to https://discows.com if unset.
NEXT_PUBLIC_SITE_URL=https://discows.com
